DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
TIME_ZONE=Asia/Dhaka
REQUIRE_EMAIL_VERIFICATION=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Leave DATABASE_URL unset to use the local SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/wellness_oasis
#
# Supabase: use a pooler host, not the direct db.<ref>.supabase.co one, which is
# IPv6-only and unreachable from most hosts. Port 5432 is the session pooler and
# is the safe default; port 6543 is the transaction pooler, which the settings
# detect and then disable persistent connections and server-side cursors for.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True
